# Copy to backend/.env for local development. Never commit real values.
AICFO_ENV=dev
AICFO_DATABASE_URL=postgresql+asyncpg://aicfo:aicfo@localhost:5432/aicfo
# Generate with: cd backend && uv run python -c "from aicfo.crypto import LocalKeyProvider as K; print(K.generate_kek())"
AICFO_LOCAL_KEKS=k1:REPLACE_ME
AICFO_ACTIVE_KEK_ID=k1
