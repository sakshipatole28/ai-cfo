# Copy to backend/.env for local development:   cp .env.example backend/.env
# backend/.env is git-ignored. Never commit real values. Synthetic data only.
AICFO_ENV=dev

# ── Database ─────────────────────────────────────────────────────────────────────────
# Local: `make dev-up` starts this Postgres. Hosted: paste the Supabase/Neon URL
# (postgres://… is accepted and switched to the psycopg driver automatically).
AICFO_DATABASE_URL=postgresql+psycopg://aicfo:aicfo@localhost:5432/aicfo

# ── LLM providers (put your keys here) ───────────────────────────────────────────────
# auto   = Groq first, Gemini as fallback, whichever keys are present (recommended)
# groq   = Groq first (Gemini still used as fallback if its key is set and LLM_FALLBACK=true)
# gemini = Gemini first
# none   = no LLM: deterministic firm policy + extractive answers (what CI uses)
AICFO_LLM_PROVIDER=auto
AICFO_LLM_FALLBACK=true
# Groq: https://console.groq.com/keys
AICFO_GROQ_API_KEY=
AICFO_GROQ_MODEL=openai/gpt-oss-120b
# Gemini: https://aistudio.google.com/apikey
AICFO_GEMINI_API_KEY=
AICFO_GEMINI_MODEL=gemini-3-flash-preview
# Optional instead: any OpenAI-compatible server (Ollama). Used only when no Groq/Gemini key.
# AICFO_LLM_BASE_URL=http://localhost:11434/v1
# AICFO_LLM_MODEL=llama3.1:8b

# ── Automation (n8n) ─────────────────────────────────────────────────────────────────
# Bearer token n8n uses for /v1/pipeline/sync and review runs. Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AICFO_AUTOMATION_TOKEN=
# Where the API sends review events (IDs and counts only) and the HMAC secret n8n checks.
# AICFO_N8N_WEBHOOK_URL=http://localhost:5678/webhook/aicfo-events
# AICFO_N8N_WEBHOOK_SECRET=

# ── Accounts and security ────────────────────────────────────────────────────────────
# Run `make init-env` once: it fills in every secret below that is empty (it never touches
# a value you already set, such as your API keys). Keep these stable: if they change, existing
# accounts can no longer sign in (the key-encryption key protects each firm's authenticator secrets).
# Key-encryption key for firm data keys, as "id:key". Production uses OpenBao instead.
AICFO_LOCAL_KEKS=k1:REPLACE_ME
AICFO_ACTIVE_KEK_ID=k1
# Signs session tokens (HS256). Required outside dev/test.
AICFO_JWT_SECRET=
# How long a sign-in lasts, in hours.
AICFO_SESSION_HOURS=12
# New firms start with a copy of the synthetic demo book so there is something to review.
AICFO_SEED_NEW_FIRMS=true

# ── Console ↔ API ────────────────────────────────────────────────────────────────────
AICFO_CORS_ORIGINS=["http://localhost:5173"]
# The console reads VITE_API_URL from frontend/.env.local (or Netlify env vars), not this file.
