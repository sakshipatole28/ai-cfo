    {
      "id": "184905af-7d6b-5d91-837a-f167d04aae67",
      "name": "Run review",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        720,
        100
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.AICFO_API_URL }}/v1/clients/{{ $json.id }}/reviews/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.AICFO_AUTOMATION_TOKEN }}"
            }
          ]
        },
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 3000
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"trigger\": \"schedule\" }"
      }
    },
    {
      "id": "4297089a-a757-5cab-b7aa-01016663bd0f",
      "name": "Summarise",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        100
      ],
      "parameters": {
        "jsCode": "// Counts only: client references are pseudonymous, and no names or amounts leave the API.\nconst runs = $input.all().map((i) => i.json);\nconst waiting = runs.filter((r) => r.kept > 0);\nreturn [{ json: {\n  runs: runs.length,\n  kept: runs.reduce((s, r) => s + r.kept, 0),\n  dropped: runs.reduce((s, r) => s + r.dropped, 0),\n  clients_with_drafts: waiting.map((r) => r.client),\n  models: [...new Set(runs.map((r) => r.model))],\n  text: `AI CFO weekly sweep: ${waiting.length} of ${runs.length} client reviews are waiting for approval.`,\n} }];"
      }
    },
    {
      "id": "b1aa623a-514a-5327-b4eb-6de905b15fd9",
      "name": "Drafts waiting and notify URL set?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1200,
        100
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "7ca9b5a0-c63f-5fc0-bf4a-fd3b29db6369",
              "leftValue": "={{ $json.kept }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            },
            {
              "id": "2931c372-660d-588e-b47e-ee4ec447d437",
              "leftValue": "={{ $env.AICFO_NOTIFY_URL }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "384f7bb8-822e-59d3-8583-a30c6aeea9eb",
      "name": "Notify advisers",
